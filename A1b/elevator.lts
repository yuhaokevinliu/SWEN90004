// Elevator simulator
ELEVATOR = EMPTY_TOP,

TOP = (
	consume -> EMPTY_TOP
),

BOTTOM = (
	send -> EMPTY_BOTTOM
),

EMPTY_TOP = (
	descend -> EMPTY_BOTTOM
	| arrive -> descend -> BOTTOM
),

EMPTY_BOTTOM = (
	ascend -> EMPTY_TOP
	|collect -> ascend -> TOP
).

PRODUCER = (arrive -> PRODUCER).
CONSUMER = (consume -> CONSUMER).

||SYSTEM_ELEVATOR = (ELEVATOR || PRODUCER || CONSUMER).

MINER = (deposit -> MINER).
STATION = EMPTY_STATION,
EMPTY_STATION = (
	deposit -> HOLD_GEM
	| send -> HOLD_CART
),
HOLD_GEM = (
	send -> READY
),
HOLD_CART = (
	deposit -> READY
),
READY = (
	collect -> EMPTY_STATION
).


ENGINE_0 = (
	send -> ENGINE_0
).
ENGINE_1 = (
	collect -> ENGINE_1
).

||SYSTEM_ENGINE = (ENGINE_0 || ENGINE_1).


||SYSTEM_STATION = (MINER || STATION || SYSTEM_ENGINE || ELEVATOR).

||SYSTEM = (SYSTEM_ELEVATOR ||SYSTEM_STATION).


